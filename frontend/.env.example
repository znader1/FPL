# Copy this file to .env and fill in your values

# Supabase
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key

# FPL Backend — set to http://localhost:8000 for local dev, remove for Azure
# VITE_FPL_API_BASE_URL=http://localhost:8000

# FPL Backend API (Azure)
VITE_FPL_SQUAD_URL=/squad?entry_id={entry_id}&event_id={event_id}
VITE_FPL_FIXTURES_URL=/fixtures?event_id={event_id}
# Optional. Defaults to the backend route; only set to override.
# VITE_FPL_ENTRY_IDENTITY_URL=/entry/identity?entry_id={entry_id}
VITE_FPL_TEAM_RECOMMENDATION_URL=/recommendations?entry_id={entry_id}&event_id={event_id}&horizon_gws={horizon_gws}&include_transfers={include_transfers}

# GW replay (personal, dev-only feature — never set in production)
# VITE_REPLAY_MODE=1
# VITE_REPLAY_ENTRY_ID=588004

# Squad picker (personal, dev-only feature — never set in production)
# VITE_SQUAD_PICKER=1
# Requires the backend running with SQUAD_PICKER_MODE=1 and:
# VITE_FPL_API_BASE_URL=http://localhost:8009
