.git
.gitignore
.venv
venv
FPL_env
__pycache__
*.pyc
*.pyo
*.pyd
.DS_Store

# Exclude data/ (runtime cache/output, gitignored) from the image, but ship
# the tracked model seeds in data/models — mirrors .gitignore lines 15-30.
# A fully-excluded parent dir can never have children un-excluded, so exclude
# data/* (not data/) and re-include data/models before excluding its contents
# again and re-including the *.json seeds.
data/*
!data/models
data/models/*
!data/models/*.json
cache
logs
kb

.env
.streamlit
# Legacy Streamlit app — handles FPL_PASSWORD and is never run by the API
# container (Dockerfile starts api.main:app), so keep it out of the image.
fpl_app_v1.py
notebooks
