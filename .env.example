# Copy this file to `.env` and fill values (never commit `.env`).

# Optional (for future LLM features)
# OPENAI_API_KEY="YOUR_KEY_HERE"

# Optional (only needed if you use the email/password flow in the Streamlit app)
# FPL_EMAIL="you@example.com"
# FPL_PASSWORD="your_password"

# Recommended (public) – used to load your squad without login
# FPL_ENTRY_ID="1234567"

# Optional – load your squad BEFORE the first gameweek deadline (pre-season).
# The public picks endpoint 404s until a GW locks; your pre-deadline squad is only
# readable via the authenticated /api/my-team/ endpoint. Log in at
# fantasy.premierleague.com, open DevTools → Network → the `my-team/<id>/` request,
# and copy the full `Cookie:` request header here. Add FPL_BEARER too if the request
# also carries an `X-Api-Authorization: Bearer ...` header. These expire — refresh
# each pre-season. Once GW1 locks, the public path is used automatically.
# FPL_COOKIE="pl_profile=...; sessionid=...; csrftoken=...; datadome=..."
# FPL_BEARER="<X-Api-Authorization bearer token>"

# Optional (recommended if you deploy the API publicly)
# FPL_API_KEY="set-a-random-long-string"
#
# Optional (if your frontend runs in a browser and needs CORS)
# Comma-separated origins, example:
# FPL_API_CORS_ORIGINS="https://your-lovable-domain.com,http://localhost:3000"

# Optional (separate key for admin-only endpoints like /admin/refresh)
# If not set, /admin/refresh falls back to FPL_API_KEY.
# FPL_ADMIN_KEY="another-random-long-string"

# Optional (cache + snapshot behavior)
# BOOTSTRAP_TTL=300
# FIXTURES_TTL=300
# FPL_SNAPSHOT_OUT_BASE="data/processed"
